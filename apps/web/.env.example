# Build-time settings for the frontend (copy to apps/web/.env.local for local use).
# Everything prefixed VITE_ is embedded in the public bundle: never put secrets here.

# Local API (wrangler dev):
VITE_API_BASE_URL=http://127.0.0.1:8787

# Deployed personal-test API. In GitHub Actions this is the repository VARIABLE
# VITE_API_BASE_URL (Settings > Secrets and variables > Actions > Variables):
# VITE_API_BASE_URL=https://opex-vbm-api.<account-subdomain>.workers.dev

# Label shown in the UI only. The API enforces the tenant independently.
VITE_GEOTAB_DATABASE=opex_trial
